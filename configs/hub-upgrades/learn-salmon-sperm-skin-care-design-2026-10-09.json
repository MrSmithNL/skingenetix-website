          "full_width": true,
          "stack_on_mobile": true,
          "subheading": "",
          "title": "",
          "content": {
            "en": "<h2>How do you read a salmon DNA label?</h2><p>Four things to check:</p>"
          },
          "background": "#FFFFFF"
        },
        "blocks": {
          "k1": {
            "type": "item",
            "settings": {
              "column_size": "4",
              "title": {
                "en": "The name"
              },
              "heading_tag": "h3",
              "content": {
                "en": "<p>Look for sodium DNA, which is the standard ingredient-list name for PDRN.</p>"
              }
            }
          },
          "k2": {
            "type": "item",
            "settings": {
              "column_size": "4",
              "title": {
                "en": "The amount"
              },
              "heading_tag": "h3",
              "content": {
                "en": "<p>A stated percentage or parts per million. If there is none, you cannot tell whether it is a trace.</p>"
              }
            }
          },
          "k3": {
            "type": "item",
            "settings": {
              "column_size": "4",
              "title": {
                "en": "The source"
              },
              "heading_tag": "h3",
              "content": {
                "en": "<p>Salmon-derived is stated on ours. &ldquo;Vegan PDRN&rdquo; is a different ingredient, and the trials above did not test it.</p>"
              }
            }
          },
          "k4": {
            "type": "item",
            "settings": {
              "column_size": "4",
              "title": {
                "en": "The claims"
              },
              "heading_tag": "h3",
              "content": {
                "en": "<p>Be wary of bold proof claims, and of results quoted from injection studies.</p>"
              }
            }
          }
        },
        "block_order": ["k1", "k2", "k3", "k4"],
