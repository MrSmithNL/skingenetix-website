              },
              "content": {
                "en": "<p>The Ye trial excluded people with a known PDRN allergy, and nobody has tested fish-allergic users.</p>"
              }
            }
          },
          "a2": {
            "type": "item",
            "settings": {
              "icon": "picto-question",
              "title": {
                "en": "Pregnant or breastfeeding"
              },
              "content": {
                "en": "<p>It has not been tested in these groups. Ask a doctor or pharmacist first.</p>"
              }
            }
          },
          "a3": {
            "type": "item",
            "settings": {
              "icon": "picto-timer",
              "title": {
                "en": "Broken, irritated or freshly treated skin"
              },
              "content": {
                "en": "<p>That includes skin after a facial, unless the practitioner says otherwise.</p>"
              }
            }
          },
          "a4": {
            "type": "item",
