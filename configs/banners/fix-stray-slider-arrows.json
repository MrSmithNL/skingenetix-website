    {
      "section": "brand_layout_css",
      "settings": {
        "html": "<style>\n/* Skingenetix brand layout overrides — Claude Code, 2026-08-21.\n   Additive only: sets custom properties the theme already exposes. No theme\n   Liquid or CSS file is modified (.claude/rules/shopify.md rules 2 and 3).\n\n   Link-block rows fill the full row width.\n   The theme sizes these by items-per-row, so a row holding fewer blocks than\n   the configured count leaves whole columns empty. Match the count to the\n   blocks actually present. Children are counted rather than section ids named,\n   so this survives renames and covers every template.\n   Floor 1000px: below that the section is a horizontal scroll-area. */\n@media screen and (min-width: 1000px) {\n  .image-link-blocks:has(> .image-link-blocks__item:nth-child(4)):not(:has(> .image-link-blocks__item:nth-child(5))) {\n    --image-link-blocks-items-per-row: 4 !important;\n  }\n  .image-link-blocks:has(> .image-link-blocks__item:nth-child(5)):not(:has(> .image-link-blocks__item:nth-child(6))) {\n    --image-link-blocks-items-per-row: 5 !important;\n  }\n}\n/* Review slider: six media-with-text items advance one at a time.\n   .media-with-text is `display:grid; overflow:hidden` with one __item per block,\n   so six blocks stack vertically. Overriding the grid to a single 100%-wide\n   auto-flow track with scroll snapping turns that stack into Tatcha's one-at-a-time\n   slider, without touching a theme file.\n   Replaces an earlier multi-column rule: that turned the reviews into a row of six\n   small tiles, which was the wrong layout — the approved one is image left, quote\n   right, and only needed sliding adding. */\n.media-with-text:has(> .media-with-text__item:nth-child(6)) {\n  grid: auto / auto-flow 100% !important;\n  overflow-x: auto !important;\n  scroll-snap-type: x mandatory;\n}\n.media-with-text:has(> .media-with-text__item:nth-child(6)) > .media-with-text__item {\n  scroll-snap-align: start;\n}\n/* Review slider arrows are always visible, not hover-only.\n   The theme reveals floating controls with\n   `.floating-controls-container:hover .is-scrollable ~ .circle-button:not([disabled])`\n   — note it requires BOTH a hover and the is-scrollable class, which is why the\n   injected arrows stayed invisible until that class was added. Hover-only is poor\n   discoverability on a review slider and Tatcha shows its arrows permanently, so\n   they are pinned visible here. The :not([disabled]) guard is kept so the theme can\n   still grey out `previous` on the first slide. */\n.floating-controls-container .media-with-text ~ .circle-button:not([disabled]) {\n  opacity: 1 !important;\n  visibility: visible !important;\n  transform: scale(1) !important;\n}\n/* Hover state for the 'See All Customer Reviews' outline button.\n   The theme gives .button--outline no hover rule at all — it is static transparent\n   with a 2px inset border — so one is added here. Setting --button-outline-color to\n   white turns both the label and that inset border white in a single move, over a\n   solid near-black fill. */\n.media-with-text__item a[href=\"/pages/reviews\"].button {\n  transition: background-color .15s ease-in-out, color .15s ease-in-out;\n}\n.media-with-text__item a[href=\"/pages/reviews\"].button:hover,\n.media-with-text__item a[href=\"/pages/reviews\"].button:focus-visible {\n  --button-outline-color: 255 255 255;\n  background-color: #1a1a1a;\n  color: #ffffff;\n}\n\n/* Homepage FAQ: heading centred full-width above, questions left, image right.\n   Claude Code, 2026-08-21. The stock FAQ section has a Text position setting that\n   gives two columns, but its heading always lives inside one of them. This re-flows\n   the same markup as a 2-col grid with the heading spanning the first row, so the\n   whole thing stays in one card and no theme file is touched.\n   Scoped by :has() on the avatar image rather than by section id — the id is\n   template-scoped and changes; the FAQ *page* has no avatar so it is unaffected. */\n@media screen and (min-width: 1150px) {\n  .shopify-section--faq:has(.faq-availability img) .section-stack--horizontal {\n    display: grid !important;\n    /* Questions column narrowed 58% -> 52% -> 46% at Malcolm's request, 2026-08-21.\n       The image column stays at 42%. justify-content is centre rather than\n       space-between: once the questions column shrank, space-between pushed the two\n       columns out to the section edges and opened a void down the middle. Centred,\n       the pair sits together as one block with even margins either side. */\n    grid-template-columns: 46% 42%;\n    justify-content: center;\n    column-gap: var(--spacing-10, 2.5rem);\n    align-items: start;\n  }\n  .shopify-section--faq:has(.faq-availability img) .section-stack__intro,\n  .shopify-section--faq:has(.faq-availability img) .section-stack__intro > .v-stack,\n  .shopify-section--faq:has(.faq-availability img) .section-stack__intro .hidden {\n    display: contents;\n  }\n  .shopify-section--faq:has(.faq-availability img) .section-stack__intro .prose {\n    grid-column: 1 / -1;\n    text-align: center;\n    margin-block-end: var(--spacing-10, 2.5rem);\n  }\n  /* Rows are pinned: the image precedes the accordions in source order, so\n     auto-placement would push the accordions to a third row. */\n  .shopify-section--faq:has(.faq-availability img) .section-stack__main {\n    grid-column: 1;\n    grid-row: 2;\n    width: auto;\n  }\n  /* The support line sits below BOTH columns, centred — Malcolm, 2026-08-22.\n     The theme wraps the avatar image and the support text together in one\n     .faq-availability block, so both are collapsed with display:contents and the\n     two children placed independently: image into column 2 of row 2, support text\n     spanning the full width on row 3. */\n  .shopify-section--faq:has(.faq-availability img) .faq-availability,\n  .shopify-section--faq:has(.faq-availability img) .faq-availability > .v-stack {\n    display: contents;\n  }\n  .shopify-section--faq:has(.faq-availability img) .faq-availability img {\n    grid-column: 2;\n    grid-row: 2;\n  }\n  .shopify-section--faq:has(.faq-availability img) .faq-availability > .v-stack > .v-stack {\n    grid-column: 1 / -1;\n    grid-row: 3;\n    text-align: center;\n    justify-items: center;\n    margin-block-start: var(--spacing-8, 2rem);\n  }\n}\n/* The Team avatar image carries an inline max-width from the section's own range\n   setting (capped at 350px), so !important is required to let it fill the column. */\n.shopify-section--faq .faq-availability img {\n  width: 100% !important;\n  max-width: 100% !important;\n  height: auto;\n  border-radius: var(--rounded-lg, 12px);\n}\n/* Brand band: cap the centred line length. Tatcha holds theirs to 520px; the stock\n   image-with-text-overlay section exposes no content-width setting. */\n.shopify-section--image-with-text-overlay .place-self-center.sm\\:place-self-center > .prose {\n  max-width: 34rem;\n  justify-items: center;\n}\n</style>\n<script>\n/* Review slider arrows — Claude Code, 2026-08-21.\n   media-with-text is the only section giving image-left / big-quote-right, and it is\n   the one section in this theme that renders no carousel controls at all. Eight other\n   sections do (shop-the-look, image-link-blocks, featured-collection and friends), so\n   rather than invent a control this reuses the theme's OWN markup: a\n   .floating-controls-container wrapper and the two `is=\"prev-button\"` /\n   `is=\"next-button\"` customized built-ins, wired by aria-controls exactly as\n   image-link-blocks does it.\n   A plain click fallback is attached as well, because customized built-in elements\n   (`is=`) are unsupported in Safari, and without it the arrows would be inert there. */\n(function () {\n  function init() {\n    document.querySelectorAll('.media-with-text').forEach(function (area, i) {\n      var items = area.querySelectorAll(':scope > .media-with-text__item');\n      // SIX, not two. This number MUST match the CSS rule above, which only turns a\n      // .media-with-text into a horizontal scroller at\n      // `:has(> .media-with-text__item:nth-child(6))`. The two drifted apart and the\n      // consequence was invisible from the homepage, where the reviews slider has\n      // exactly six items and looked right: arrows were injected onto EVERY\n      // media-with-text on the site with two or more blocks, including the 3-block\n      // Key Findings sections on all five research pages and the Philosophy page's\n      // science story. Those sections are never converted to scrollers, so the arrows\n      // were not merely redundant - they were dead controls. scrollBy({left: ...}) on\n      // a vertical stack scrolls nothing, and the CSS below pins them permanently\n      // visible, so they advertised an interaction that could not happen.\n      // Reported by Malcolm on /pages/copper-peptide-research, 2026-08-25.\n      if (items.length < 6) return;\n      if (area.closest('.floating-controls-container')) return;\n\n      var id = area.id || ('sg-review-slider-' + i);\n      area.id = id;\n      area.classList.add('scroll-area');\n      area.classList.add('is-scrollable');\n\n      var wrap = document.createElement('div');\n      wrap.className = 'floating-controls-container';\n      area.parentNode.insertBefore(wrap, area);\n      wrap.appendChild(area);\n\n      wrap.insertAdjacentHTML('beforeend',\n        '<button is=\"prev-button\" class=\"circle-button circle-button--fill border group\" aria-controls=\"' + id + '\">' +\n          '<span class=\"sr-only\">Previous</span><span class=\"animated-arrow animated-arrow--reverse\"></span>' +\n        '</button>' +\n        '<button is=\"next-button\" class=\"circle-button circle-button--fill border group\" aria-controls=\"' + id + '\">' +\n          '<span class=\"sr-only\">Next</span><span class=\"animated-arrow\"></span>' +\n        '</button>');\n\n\n      // Shopify's richtext sanitiser strips class/style from anchors, so the\n      // 'See All Customer Reviews' link is stored plain and given the theme's own\n      // button classes here. Runtime DOM is not subject to that sanitiser.\n      area.querySelectorAll('.media-with-text__item a[href=\"/pages/reviews\"]').forEach(function (a) {\n        if (a.classList.contains('button')) return;\n        a.classList.add('button', 'button--outline');\n        a.style.setProperty('--button-text-color', '26 26 26');\n        a.style.setProperty('--button-outline-color', '26 26 26');\n      });\n\n      var prev = wrap.querySelector('[is=\"prev-button\"]');\n      var next = wrap.querySelector('[is=\"next-button\"]');\n\n      function step(dir) {\n        area.scrollBy({ left: dir * area.clientWidth, behavior: 'smooth' });\n      }\n      // Fallback only: if the theme upgraded the button it handles its own click and\n      // this simply moves by the same amount, so behaviour is identical either way.\n      prev.addEventListener('click', function (e) { if (!e.defaultPrevented) step(-1); });\n      next.addEventListener('click', function (e) { if (!e.defaultPrevented) step(1); });\n    });\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n\n/* FAQ image served at full resolution — Claude Code, 2026-08-22.\n   The theme builds this img from the section's Team avatar setting, whose range\n   caps at 350px, so it emits sizes=\"350px\" and a srcset topping out at 700w. The\n   CSS above stretches the element to fill a ~430px column, and on a 2x display the\n   browser still has only a 700w candidate to work with. A 2048px source was landing\n   as a soft upscale, and the thinning closed the D of PDRN into an O — the exact\n   substitution rejected during selection, arriving through resampling rather than\n   generation. Dropping srcset/sizes and requesting an explicit width from the CDN\n   restores real detail. Runtime DOM only; no theme file is touched. */\n(function () {\n  function sharpen() {\n    document.querySelectorAll('.shopify-section--faq .faq-availability img').forEach(function (img) {\n      var src = img.getAttribute('src') || '';\n      if (src.indexOf('/cdn/shop/') === -1 || img.dataset.sgSharpened) return;\n      img.dataset.sgSharpened = '1';\n      img.removeAttribute('srcset');\n      img.removeAttribute('sizes');\n      img.setAttribute('src', /[?&]width=\\d+/.test(src)\n        ? src.replace(/([?&]width=)\\d+/, '$11600')\n        : src + (src.indexOf('?') === -1 ? '?' : '&') + 'width=1600');\n    });\n  }\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', sharpen);\n  } else {\n    sharpen();\n  }\n})();\n</script>"
      }
    }
  ],
  "undo": "python3 scripts/patch-template.py --restore backups/footer-group-20260825-151813.json --template sections/footer-group.json  (verified stamp; the commit message guessed 152504, which does not exist)"
