  "new_sections": [
    {
      "id": "faq_image_layout",
      "insert_after": "cta",
      "section": {
        "type": "custom-html",
        "settings": {
          "full_width": true,
          "remove_vertical_spacing": true,
          "remove_horizontal_spacing": true,
          "html": "<style>\n/* /pages/faq - picture + title in the left column, accordions right.\n   Claude Code, 2026-08-25, at Malcolm's request.\n\n   The two-column layout is the theme's own: accordion-content defaults to\n   text_position 'start', which already gives .section-stack--horizontal with a 50%\n   .section-stack__intro on the left and .section-stack__main on the right. Nothing\n   about the columns is changed here - the left column was simply a title floating in\n   636px of empty space, and this fills it.\n\n   accordion-content has NO image setting in its schema, and its `content` field is a\n   richtext whose sanitiser strips <img>. So the picture is injected as a real <img>\n   at runtime rather than faked with a CSS background: that keeps alt text, native\n   lazy-loading and a srcset, which a background-image would all throw away.\n\n   Scoped to this page because the section lives in templates/page.faq.json. */\n\n.shopify-section--accordion-content .section-stack__intro .prose { position: relative; }\n\n.shopify-section--accordion-content .section-stack__intro .prose > img.sg-faq-image {\n  display: block;\n  width: 100%;\n  aspect-ratio: 4 / 3;\n  object-fit: cover;\n  border-radius: var(--rounded-sm);\n  margin: 0;\n}\n\n/* Top scrim so the white title holds its contrast against the photograph. Measured on the homepage tiles earlier today: a flat\n   overlay strong enough for a 15px label greys the whole picture, whereas a gradient\n   buys the contrast only where the type sits. Same reasoning, same shape.\n\n   ANCHORED TOP since 2026-08-25, at Malcolm's request: the title now sits at the top of\n   the image area, level with the first accordion row in the right-hand column, so the two\n   columns start on the same line instead of the title sinking 400px below it. The scrim\n   was flipped with it - a bottom scrim under a top title would darken the empty half of\n   the picture and leave the type on whatever happens to be up there. */\n.shopify-section--accordion-content .section-stack__intro .prose::after {\n  content: \"\";\n  position: absolute;\n  inset: 0 0 auto 0;\n  height: 60%;\n  background: linear-gradient(to bottom,\n    rgb(0 0 0 / 0.62) 0%,\n    rgb(0 0 0 / 0.42) 24%,\n    rgb(0 0 0 / 0.14) 52%,\n    rgb(0 0 0 / 0) 100%);\n  border-radius: var(--rounded-sm) var(--rounded-sm) 0 0;\n  pointer-events: none;\n  z-index: 1;\n}\n\n.shopify-section--accordion-content .section-stack__intro .prose > h2 {\n  position: absolute;\n  z-index: 2;\n  left: var(--spacing-6, 1.5rem);\n  right: var(--spacing-6, 1.5rem);\n  top: var(--spacing-5, 1.25rem);\n  margin: 0;\n  color: #ffffff;\n}\n\n/* One of the five pictures - the open jar - is a bright product shot on a pale ground,\n   and the standard scrim leaves its title at 4.0:1 where the other four sit between 10:1\n   and 20:1. Measured off the live page, not guessed. A pale picture simply needs more\n   scrim, so it gets its own ramp rather than the whole set being darkened to suit the\n   brightest member of it. Which blocks are pale is data, not a hardcoded id: the JS below\n   adds this class from a `bright` flag in the IMAGES map. */\n.shopify-section--accordion-content.sg-faq-bright .section-stack__intro .prose::after {\n  background: linear-gradient(to bottom,\n    rgb(0 0 0 / 0.88) 0%,\n    rgb(0 0 0 / 0.72) 22%,\n    rgb(0 0 0 / 0.30) 55%,\n    rgb(0 0 0 / 0) 100%);\n}\n\n/* Variant, one class away: title ABOVE the picture rather than over it. Add\n   .sg-faq-title-above to the section to switch. Kept in the stylesheet so the two can\n   be compared on the live page without another publish. */\n.shopify-section--accordion-content.sg-faq-title-above .section-stack__intro .prose::after { display: none; }\n.shopify-section--accordion-content.sg-faq-title-above .section-stack__intro .prose > h2 {\n  position: static;\n  color: inherit;\n  margin: 0 0 var(--spacing-5, 1.25rem) 0;\n}\n.shopify-section--accordion-content.sg-faq-title-above .section-stack__intro .prose > img.sg-faq-image {\n  order: 2;\n}\n.shopify-section--accordion-content.sg-faq-title-above .section-stack__intro .prose {\n  display: flex;\n  flex-direction: column;\n}\n</style>\n<script>\n/* Inject the FAQ category picture as the first child of each intro column.\n   Claude Code, 2026-08-25. Sources, and the reason for each engine choice, are in\n   configs/banners/faq-category-images-publish.json.\n\n   Keyed on the section id suffix (the part after '__'), never on the full id: the\n   template-scoped prefix changes whenever the template is rebuilt. */\n(function () {\n  var IMAGES = {\n      \"faq_products\": {\n          \"src\": \"https://cdn.shopify.com/s/files/1/0932/8679/3601/files/skingenetix-woman-applying-peptide-face-cream-to-cheek.jpg\",\n          \"alt\": \"A woman applying a small dab of pale blue peptide face cream to her cheekbone with her fingertips, against a deep graphite background\"\n      },\n      \"faq_ingredients\": {\n          \"bright\": true,\n          \"src\": \"https://cdn.shopify.com/s/files/1/0932/8679/3601/files/skingenetix-copper-peptide-night-cream-texture-open-jar-macro.jpg\",\n          \"alt\": \"An extreme close-up looking down into the open jar of Skingenetix Copper Peptide Advanced Night Repair, the pale blue cream swirled to a soft peak inside the frosted glass rim\"\n      },\n      \"faq_shipping\": {\n          \"src\": \"https://cdn.shopify.com/s/files/1/0932/8679/3601/files/skingenetix-skincare-order-packed-white-shipping-box.jpg\",\n          \"alt\": \"A plain white shipping box sealed with paper tape and printed with the Skingenetix helix mark on the lid, on a dark graphite surface\"\n      },\n      \"faq_returns\": {\n          \"src\": \"https://cdn.shopify.com/s/files/1/0932/8679/3601/files/skingenetix-smiling-woman-checking-skincare-order-phone.png\",\n          \"alt\": \"A smiling middle-aged woman looking down at her mobile phone, pleased with what she is reading, against a deep graphite background\"\n      },\n      \"faq_skincare\": {\n          \"bright\": true,\n          \"src\": \"https://cdn.shopify.com/s/files/1/0932/8679/3601/files/skingenetix-clear-serum-pipette-drop-on-cheek-macro.jpg\",\n          \"alt\": \"A macro close-up filling the frame with a woman's cheek as a clear serum falls from a glass pipette held just above her cheekbone\"\n      }\n  };\n  var WIDTHS = [400, 600, 800, 1000, 1200, 1600];\n\n  function init() {\n    document.querySelectorAll('.shopify-section--accordion-content').forEach(function (section) {\n      var key = (section.id || '').split('__').pop();\n      var spec = IMAGES[key];\n      if (!spec) return;\n\n      if (spec.bright) section.classList.add('sg-faq-bright');\n\n      var prose = section.querySelector('.section-stack__intro .prose');\n      if (!prose || prose.querySelector('img.sg-faq-image')) return;\n\n      var img = document.createElement('img');\n      img.className = 'sg-faq-image';\n      img.src = spec.src + '?width=1200';\n      img.srcset = WIDTHS.map(function (w) {\n        return spec.src + '?width=' + w + ' ' + w + 'w';\n      }).join(', ');\n      // The intro column is 50% of the container, 636px at 1440.\n      img.sizes = '(max-width: 999px) 100vw, min(636px, 46vw)';\n      img.alt = spec.alt;\n      img.width = 1600;\n      img.height = 1200;\n      img.loading = 'lazy';\n      img.decoding = 'async';\n\n      prose.insertBefore(img, prose.firstChild);\n    });\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>"
        }
      }
    }
  ],
  "the_422_trap": "Shopify rejects a custom-html `html` setting containing '{{', '}}', '{%' or '%}' - it reads them as Liquid. An inlined json.dumps() map ends '...}}' and trips it with no hint that JSON is the cause. Emit the map with indent so no two braces abut, and assert on all four tokens before pushing."
}
